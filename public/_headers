# Response headers for Netlify and Cloudflare Pages.

# Built JS/CSS have hashed names, so they can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Ticket data changes only when it's rebuilt; cache for a day.
/data/*
  Cache-Control: public, max-age=86400

# Always check for a new page and service worker so updates roll out.
/sw.js
  Cache-Control: no-cache
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=()

/manifest.webmanifest
  Content-Type: application/manifest+json
