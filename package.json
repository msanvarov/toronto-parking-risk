{
  "name": "toronto-parking-risk",
  "private": true,
  "version": "0.1.0",
  "description": "Mobile-first web app that scores how likely a parking ticket is on any Toronto block, built from City of Toronto ticket data.",
  "author": "Sal Anvarov <msalanvarov@gmail.com> (https://sal-anvarov.com)",
  "homepage": "https://toronto-parking-risk.netlify.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/msanvarov/toronto-parking-risk.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "data": "python3 scripts/build_data.py --latest 2"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
